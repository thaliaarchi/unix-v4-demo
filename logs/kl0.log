makename(dir, file)
char *dir, *file;
{
        static char dfile[100];
        register char *dp, *fp;
        register int i;

        dp = dfile;
        fp = dir;
        while (*fp)
                *dp++ = *fp++;
        *dp++ = '/';
        fp = file;
        for (i=0; i<14; i++)
                *dp++ = *fp++;
        *dp = 0;
        return(dfile);
}
