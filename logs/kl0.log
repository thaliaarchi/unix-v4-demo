        }
        i = 0;
        do {
                if(argc<=0) buf[0] = 0;
                else if(fopen(argv[i],buf)<0) {
                        printf("%s: cannot open\n", argv[i]);
                        continue;
                }
                count();
                for(j=1;code[j];j++) {
                        switch(code[j]) {
                        case 'l':
