iput(p)
struct inode *p;
{
        register *rp;

        rp = p;
        if(rp->i_count == 1) {
                rp->i_flag =| ILOCK;
                if(rp->i_nlink <= 0) {
                        itrunc(rp);
                        rp->i_mode = 0;
                        ifree(rp->i_dev, rp->i_number);
                }
                iupdat(rp);
                prele(rp);
                rp->i_flag = 0;
                rp->i_number = 0;
        }
        rp->i_count--;
        prele(rp);
}
