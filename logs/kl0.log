        jsr     r0,mtrack; 10110
        jsr     r0,mtrack; 11010
        jsr     r0,mtrack; 01000
        jsr     r0,mtrack; 01000
        jsr     r0,mtrack; 01000
        jsr     r0,mtrack; 01000
        mov     $nword-4,r4
