                                break;
                        }
                }
                printf("%s\n", argc<=0?"":argv[i]);
        } while(++i<argc);
}

count()
{
        register newline, token, c;
        newline = 1;
        token = 0;
        clear(linect);
        clear(alphct);
        clear(punct);
        clear(wordct);
        clear(ctlct);
        while((c=getc(buf))>=0) {
