{
        register struct tty *tp;
        extern dhstart();

        if (dev.d_minor >= NDH11) {
                u.u_error = ENXIO;
                return;
        }
        tp = &dh11[dev.d_minor];
        tp->t_addr = dhstart;
        DHADDR->dhcsr =| IENABLE;
        tp->t_state =| WOPEN|SSTART;
        if ((tp->t_state&ISOPEN) == 0) {
                tp->t_quit = 034;               /* FS */
                tp->t_intrup = 0177;            /* DEL */
                tp->t_speeds = SSPEED | (SSPEED<<8);
                tp->t_flags = ODDP|EVENP|ECHO;
                dhparam(tp);
        }
        dmopen(dev);
        tp->t_state =& ~WOPEN;
        tp->t_state =| ISOPEN;
