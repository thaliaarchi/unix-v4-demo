ttyoutput(ac, tp)
struct tty *tp;
{
        register int c;
        register struct tty *rtp;
        register char *colp;
        int ctype;

        rtp = tp;
        c = ac&0177;
        if (c==004 && (rtp->t_flags&RAW)==0)
                return;
        if (c=='\t' && rtp->t_flags&XTABS) {
                do
                        ttyoutput(' ', rtp);
                while (rtp->t_col&07);
                return;
        }
        if (rtp->t_flags&LCASE) {
                switch (c) {

                case '{':
                        c = '(';
                        goto esc;

                case '}':
                        c = ')';
                        goto esc;

                case '|':
                        c = '!';
                        goto esc;

                case '~':
                        c = '^';
                        goto esc;

                case '`':
                        c = '\'';

                esc:
                        ttyoutput('\\', rtp);
                }
                if ('a'<=c && c<='z')
                        c =+ 'A' - 'a';
        }
        if (c=='\n' && rtp->t_flags&CRMOD)
                ttyoutput('\r', rtp);
        if (putc(c, &rtp->t_outq))
                return;
        colp = &rtp->t_col;
        ctype = partab[c];
        c = 0;
        switch (ctype&077) {

        /* ordinary */
        case 0:
                (*colp)++;

        /* non-printing */
        case 1:
                break;

        /* backspace */
        case 2:
                if (*colp)
                        (*colp)--;
                break;

        /* newline */
        case 3:
                if (*colp)
                        c = max((*colp>>4) + 3, 6);
                *colp = 0;
                break;

        /* tab */
        case 4:
                if ((rtp->t_flags&NTDELAY)==0)
                        c = 1 - (*colp | ~07);
                *colp =| 07;
                (*colp)++;
                break;

        /* vertical motion */
        case 5:
                c = 0177;
                break;

        /* carriage return */
        case 6:
                c = 6;
                *colp = 0;
        }
        if (c && (rtp->t_flags&NODELAY)==0)
                putc(c|0200, &rtp->t_outq);
}
