                cs = csym;
                if (cs->hclass==0 && cs->htype==0)
                        if(nextchar()=='(') {
                                /* set function */
                                cs->hclass = EXTERN;
                                cs->htype = FUNC;
                        } else if (initflg)
                                cs->hclass = EXTERN;
                        else {
                                /* set label */
                                cs->htype = ARRAY;
                                if (cs->hoffset==0)
                                        cs->hoffset = isn++;
                        }
                *cp++ = block(2,NAME,cs->htype,cs->hdimp,
                    cs->hclass,0);
                if (cs->hclass==EXTERN) {
