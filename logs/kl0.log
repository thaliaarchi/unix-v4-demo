sbreak()
{
        register a, n, d;
        int i;

        /*
         * set n to new data size
         * set d to new-old
         * set n to new total size
         */

        n = (((u.u_arg[0]+63)>>6) & 01777) - nseg(u.u_tsize)*128;
        if(n < 0)
                n = 0;
        d = n - u.u_dsize;
        n =+ USIZE+u.u_ssize;
        if(estabur(u.u_tsize, u.u_dsize+d, u.u_ssize))
                return;
        u.u_dsize =+ d;
        if(d > 0)
                goto bigger;
        a = u.u_procp->p_addr + n - u.u_ssize;
        i = n;
        n = u.u_ssize;
        while(n--) {
                copyseg(a-d, a);
                a++;
        }
        expand(i);
        return;

bigger:
        expand(n);
        a = u.u_procp->p_addr + n;
        n = u.u_ssize;
        while(n--) {
                a--;
                copyseg(a-d, a);
        }
        while(d--)
                clearseg(--a);
}
