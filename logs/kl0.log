        jsr     r0,mtrack; 111011
        jsr     r0,mtrack; 111011
        jsr     r0,mtrack; 111011
        jsr     r0,mtrack; 111011
        jsr     r0,mtrack; 101001
        jsr     r0,mtrack; 100101
        jsr     r0,mtrack; 10101
        dec     r3
