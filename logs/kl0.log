iupdat(p)
int *p;
{
        register *ip1, *ip2, *rp;
        int *bp, i;

        rp = p;
        if((rp->i_flag&(IUPD|IACC)) != 0) {
                if(getfs(rp->i_dev)->s_ronly)
                        return;
                i = rp->i_number+31;
                bp = bread(rp->i_dev, ldiv(i,16));
                ip1 = bp->b_addr + 32*lrem(i, 16);
                ip2 = &rp->i_mode;
                while(ip2 < &rp->i_addr[8])
                        *ip1++ = *ip2++;
                if(rp->i_flag&IACC) {
                        *ip1++ = time[0];
                        *ip1++ = time[1];
                } else
                        ip1 =+ 2;
                if(rp->i_flag&IUPD) {
                        *ip1++ = time[0];
                        *ip1++ = time[1];
                }
                bwrite(bp);
        }
}
