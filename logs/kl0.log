int *av;
{
        register struct tty *tp;
        register r;
        register int *v;

        tp = &dc11[dev.d_minor];
        v = av;
        if (v) {
                *v++ = tp->t_speeds;
                *v++ = 0;
                *v++ = tp->t_flags;
                return;
        }
        wflushtty(tp);
        tp->t_speeds = u.u_arg[0];
        tp->t_flags = u.u_arg[2];
        if (r = dcrstab[tp->t_speeds.lobyte&017])
                tp->t_addr->dcrcsr = r;
        if (r = dctstab[tp->t_speeds.hibyte&017])
                tp->t_addr->dctcsr = r;
}
