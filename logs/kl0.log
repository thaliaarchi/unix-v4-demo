        tst     r0
        beq     1b
        cmp     r0,$1
        bne     err
        jsr     pc,get
        jsr     pc,get
        mov     r0,-(sp)
        jsr     pc,get
        swab    r0
        bis     r0,(sp)
        jsr     pc,get
        mov     r0,r1
        jsr     pc,get
        swab    r0
        bis     r0,r1
        sub     $6,(sp)
        ble     2f
