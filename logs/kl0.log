        case AND:
        case TIMES:
                if (andflg)
                        andflg = 0; else
                        if(o==AND)
                                o = AMPER;
                        else
                                o = STAR;
                goto oponst;

        case LPARN:
                if (andflg) {
                        o = symbol();
                        if (o==RPARN)
                                o = MCALL;
                        else {
                                peeksym = o;
                                o = CALL;
                                andflg = 0;
                        }
                }
                goto oponst;

        case RBRACK:
        case RPARN:
                if (!andflg)
