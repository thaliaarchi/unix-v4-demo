match(s, p)
char *s, *p; {
        if (*s=='.' && *p!='.') return(0);
        return(amatch(s, p));
}

amatch(s, p)
char *s, *p;
{
        int c, cc, ok, lc, scc;

        scc = *s;
        lc = 077777;
        switch (c = *p) {

        case '[':
                ok = 0;
                while (cc = *++p) {
                        switch (cc) {

                        case ']':
